{
  "version": 2,
  "public": true,
  "rewrites": [
    {
      "source": "/(css|js|images|fonts)/:path*",
      "destination": "/public/$1/:path*"
    },
    {
      "source": "/(.*\\.(png|jpg|jpeg|gif|webp|svg|ico|awebp))",
      "destination": "/public/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/doc/$1"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}